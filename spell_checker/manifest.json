{
  "manifest_version": 3,
  "name": "AI Spell Checker",
  "version": "1.0",
  "description": "Spell checker with AI corrections",
  "permissions": ["scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
